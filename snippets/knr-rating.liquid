{%- comment -%} Star rating. Params: rating (0–5), label (optional aria text) {%- endcomment -%}
{%- liquid
  assign star_rating = rating | default: 0 | times: 1.0
  assign fill_pct = star_rating | times: 20.0
-%}
<span class="knr-rating" role="img" aria-label="{{ label | default: star_rating }} sur 5">
  <span class="knr-rating__layer knr-rating__base">{% for i in (1..5) %}{% render 'knr-star' %}{% endfor %}</span>
  <span class="knr-rating__layer knr-rating__fill" style="width: {{ fill_pct }}%;">{% for i in (1..5) %}{% render 'knr-star' %}{% endfor %}</span>
</span>
