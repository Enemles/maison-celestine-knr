{%- liquid
  assign callout_product = product.metafields.custom.ingredient_product.value | default: section.settings.product | default: product
  assign cp_variant = callout_product.selected_or_first_available_variant
  assign ing_image = product.metafields.custom.ingredient_image.value | default: section.settings.image
  assign ing_image_mobile = product.metafields.custom.ingredient_image_mobile.value | default: section.settings.image_mobile
  assign ing_label = product.metafields.custom.ingredient_label.value | default: section.settings.label
  assign ing_manifesto = product.metafields.custom.ingredient_manifesto.value | default: section.settings.manifesto
  assign ing_attribution = product.metafields.custom.ingredient_attribution.value | default: section.settings.attribution
-%}

<section class="knr-ingredients" data-ingredients>
  <div class="knr-ingredients__media">
    {%- if ing_image != blank -%}
      <picture>
        {%- if ing_image_mobile != blank -%}
          <source media="(max-width: 749px)" srcset="{{ ing_image_mobile | image_url: width: 390 }} 390w, {{ ing_image_mobile | image_url: width: 780 }} 780w, {{ ing_image_mobile | image_url: width: 1170 }} 1170w" sizes="100vw">
        {%- endif -%}
        {{ ing_image | image_url: width: 2880 | image_tag: class: 'knr-ingredients__img', loading: 'lazy', widths: '1440, 2880', sizes: '100vw', alt: '' }}
      </picture>
    {%- endif -%}
    <div class="knr-ingredients__gradient" aria-hidden="true"></div>

    <div class="knr-ingredients__overlay">
      <div class="knr-ingredients__intro">
        {%- if ing_label != blank -%}
          <span class="knr-ingredients__label">{{ ing_label }}</span>
          <span class="knr-ingredients__rule" aria-hidden="true"></span>
        {%- endif -%}
      </div>
      <div class="knr-ingredients__manifesto">
        {%- if ing_manifesto != blank -%}
          <div class="knr-ingredients__manifesto-text">{{ ing_manifesto }}</div>
        {%- endif -%}
        {%- if ing_attribution != blank -%}
          <span class="knr-ingredients__attribution">{{ ing_attribution }}</span>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- if callout_product != blank and cp_variant != blank -%}
    <div class="knr-ingredients__callout">
      {%- form 'product', callout_product, class: 'knr-ingredients__form' -%}
        <div class="knr-ingredients__product">
          <div class="knr-ingredients__thumb">
            {%- if callout_product.featured_image -%}
              {{ callout_product.featured_image | image_url: width: 208 | image_tag: class: 'knr-ingredients__thumb-img', loading: 'lazy', widths: '104, 208', alt: callout_product.title | escape }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'knr-ingredients__thumb-img' }}
            {%- endif -%}
          </div>
          <div class="knr-ingredients__details">
            <div class="knr-ingredients__head">
              <p class="knr-ingredients__name">{{ callout_product.title }}</p>
              {%- if callout_product.variants.size > 1 -%}
                <div class="knr-ingredients__variants">
                  {%- for variant in callout_product.variants -%}
                    <label class="knr-ingredients__variant{% if variant.id == cp_variant.id %} is-selected{% endif %}">
                      <input type="radio" name="id" value="{{ variant.id }}"{% if variant.id == cp_variant.id %} checked{% endif %}{% unless variant.available %} disabled{% endunless %}>
                      <span>{{ variant.title }}</span>
                    </label>
                  {%- endfor -%}
                </div>
              {%- else -%}
                <input type="hidden" name="id" value="{{ cp_variant.id }}">
              {%- endif -%}
            </div>
            <p class="knr-ingredients__price" data-ing-price>{{ cp_variant.price | money }}</p>
          </div>
        </div>

        <button type="submit" class="knr-ingredients__add" data-ing-add{% unless cp_variant.available %} disabled{% endunless %}>
          <span data-ing-label>{{ section.settings.button_label | default: 'Ajouter au panier' }}</span>
        </button>
      {%- endform -%}

      <script type="application/json" data-ing-variants>
        [{% for v in callout_product.variants %}{"id":{{ v.id }},"price":{{ v.price | money | json }},"available":{{ v.available }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
      </script>
    </div>
  {%- endif -%}
</section>

{{ 'knr-ingredients.css' | asset_url | stylesheet_tag }}
<script src="{{ 'knr-ingredients.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "KNR Ingrédients",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image de fond (sombre de préférence)" },
    { "type": "image_picker", "id": "image_mobile", "label": "Image de fond — mobile (optionnel)" },
    { "type": "text", "id": "label", "label": "Petit titre", "default": "Notre engagement pour une beauté régénérée" },
    { "type": "richtext", "id": "manifesto", "label": "Manifeste", "default": "<p>Fusionnant l'huile de rosier muscat, le rétinol végétal et l'extrait de cactus, notre sérum pénètre en profondeur pour stimuler le renouvellement cellulaire, atténuer les rides et redonner à la peau son éclat et sa fermeté naturels.</p>" },
    { "type": "text", "id": "attribution", "label": "Signature", "default": "Sophie M." },
    { "type": "header", "content": "Badge produit (ajout au panier)" },
    { "type": "product", "id": "product", "label": "Produit mis en avant (sinon le produit de la page)" },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Ajouter au panier" }
  ],
  "presets": [{ "name": "KNR Ingrédients" }]
}
{% endschema %}
