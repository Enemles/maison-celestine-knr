<section class="knr-faq" data-faq>
  <div class="knr-faq__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="knr-faq__title">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- assign faq_items = product.metafields.custom.faq.value -%}
    {%- if faq_items != blank -%}
      <div class="knr-faq__list">
        {%- for item in faq_items -%}
          <details class="knr-faq__item"{% if forloop.first %} open{% endif %}>
            <summary class="knr-faq__head">
              <span class="knr-faq__q">{{ item.question }}</span>
              <span class="knr-faq__icon">{% render 'knr-chevron' %}</span>
            </summary>
            <div class="knr-faq__body">
              <div class="knr-faq__answer">{{ item.answer }}</div>
            </div>
          </details>
        {%- endfor -%}
      </div>
    {%- elsif section.blocks.size > 0 -%}
      <div class="knr-faq__list">
        {%- for block in section.blocks -%}
          <details class="knr-faq__item"{% if forloop.first %} open{% endif %} {{ block.shopify_attributes }}>
            <summary class="knr-faq__head">
              <span class="knr-faq__q">{{ block.settings.question | escape }}</span>
              <span class="knr-faq__icon">{% render 'knr-chevron' %}</span>
            </summary>
            <div class="knr-faq__body">
              <div class="knr-faq__answer">{{ block.settings.answer }}</div>
            </div>
          </details>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{{ 'knr-faq.css' | asset_url | stylesheet_tag }}
<script src="{{ 'knr-faq.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "KNR FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Questions fréquentes" }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Réponse" }
      ]
    }
  ],
  "presets": [
    {
      "name": "KNR FAQ",
      "blocks": [
        { "type": "qa", "settings": { "question": "Comment utiliser ce sérum ?", "answer": "<p>Appliquez 3 à 4 gouttes matin et soir sur une peau propre et sèche, avant votre soin hydratant.</p>" } },
        { "type": "qa", "settings": { "question": "Convient-il aux peaux sensibles ?", "answer": "<p>Oui. Sa formule sans parfum ni alcool a été testée sous contrôle dermatologique sur peaux sensibles.</p>" } },
        { "type": "qa", "settings": { "question": "Quels sont les ingrédients clés ?", "answer": "<p>Un complexe régénérant associant acide hyaluronique, niacinamide et huiles botaniques précieuses.</p>" } },
        { "type": "qa", "settings": { "question": "Au bout de combien de temps voit-on des résultats ?", "answer": "<p>Une peau visiblement plus lumineuse dès 7 jours ; les résultats sur le grain et la fermeté s'installent en 4 à 6 semaines.</p>" } },
        { "type": "qa", "settings": { "question": "Le produit est-il testé sur les animaux ?", "answer": "<p>Jamais. Maison Célestine est une marque cruelty-free, certifiée et fabriquée en France.</p>" } }
      ]
    }
  ]
}
{% endschema %}
