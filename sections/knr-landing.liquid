{%- liquid
  assign feat = section.settings.product | default: collections.all.products.first
  assign hero_img = section.settings.image | default: feat.featured_image
-%}

<section class="knr-landing">
  {%- if hero_img != blank -%}
    {{ hero_img | image_url: width: 2400 | image_tag: class: 'knr-landing__img', loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1800, 2400', sizes: '100vw', alt: '' }}
  {%- endif -%}
  <div class="knr-landing__scrim" aria-hidden="true"></div>

  <div class="knr-landing__content">
    {%- if section.settings.eyebrow != blank -%}
      <span class="knr-landing__eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    <h1 class="knr-landing__title">{{ section.settings.heading | default: feat.title | default: shop.name }}</h1>
    {%- if section.settings.subheading != blank -%}
      <p class="knr-landing__text">{{ section.settings.subheading }}</p>
    {%- endif -%}
    <a class="knr-landing__cta" href="{{ feat.url | default: routes.all_products_collection_url }}">
      {{- section.settings.cta_label | default: 'Découvrir le produit' -}}
    </a>
  </div>
</section>

{{ 'knr-landing.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "KNR Landing",
  "settings": [
    { "type": "product", "id": "product", "label": "Produit mis en avant (sinon 1er produit du store)" },
    { "type": "image_picker", "id": "image", "label": "Image de fond (sinon image du produit)" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Maison Célestine" },
    { "type": "text", "id": "heading", "label": "Titre (sinon nom du produit)" },
    { "type": "text", "id": "subheading", "label": "Sous-titre", "default": "Le soin régénérant qui sublime votre peau en 4 semaines." },
    { "type": "text", "id": "cta_label", "label": "Libellé du bouton", "default": "Découvrir le produit" }
  ],
  "presets": [{ "name": "KNR Landing" }]
}
{% endschema %}
