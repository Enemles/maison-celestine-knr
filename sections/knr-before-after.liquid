{%- liquid
  assign before_img = product.metafields.custom.before_image.value | default: section.settings.before_image
  assign after_img = product.metafields.custom.after_image.value | default: section.settings.after_image
  assign caption = product.metafields.custom.before_after_caption.value | default: section.settings.caption

  assign t_items = product.metafields.custom.testimonials.value
  assign has_meta_t = false
  if t_items != blank
    assign has_meta_t = true
  endif
  if has_meta_t
    assign t_count = t_items | size
  else
    assign t_count = section.blocks.size
  endif
-%}

<section class="knr-ba" data-ba>
  <div class="knr-ba__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="knr-ba__title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.description != blank -%}
      <div class="knr-ba__desc">{{ section.settings.description }}</div>
    {%- endif -%}

    <div class="knr-ba__compare" data-ba-compare>
      <div class="knr-ba__layer knr-ba__before">
        {%- if before_img != blank -%}
          {{ before_img | image_url: width: 1280 | image_tag: class: 'knr-ba__img', loading: 'lazy', widths: '640, 1280', sizes: '(max-width: 749px) 100vw, 1280px', alt: section.settings.before_label }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'knr-ba__img knr-ba__img--ph' }}
        {%- endif -%}
        <span class="knr-ba__tag knr-ba__tag--before">{{ section.settings.before_label | default: 'Avant' }}</span>
      </div>
      <div class="knr-ba__layer knr-ba__after">
        {%- if after_img != blank -%}
          {{ after_img | image_url: width: 1280 | image_tag: class: 'knr-ba__img', loading: 'lazy', widths: '640, 1280', sizes: '(max-width: 749px) 100vw, 1280px', alt: section.settings.after_label }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'knr-ba__img knr-ba__img--ph' }}
        {%- endif -%}
        <span class="knr-ba__tag knr-ba__tag--after">{{ section.settings.after_label | default: 'Après' }}</span>
      </div>
      <span class="knr-ba__handle" aria-hidden="true"></span>
      <input type="range" class="knr-ba__range" min="0" max="100" value="50" step="0.1" data-ba-range aria-label="Comparer l'avant et l'après">
    </div>

    {%- if caption != blank -%}
      <p class="knr-ba__caption">{{ caption }}</p>
    {%- endif -%}

    {%- if t_count > 0 -%}
      <div class="knr-ba__quotes" data-ba-carousel>
        {%- if t_count > 1 -%}
          <div class="knr-ba__dots">
            {%- for i in (1..t_count) -%}
              <button type="button" class="knr-ba__dot{% if forloop.first %} is-active{% endif %}" data-ba-dot aria-label="Témoignage {{ forloop.index }}"></button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="knr-ba__quotes-track">
          {%- if has_meta_t -%}
            {%- for t in t_items -%}
              <figure class="knr-ba__quote{% if forloop.first %} is-active{% endif %}" data-ba-slide>
                <blockquote class="knr-ba__quote-text">{{ t.quote }}</blockquote>
                {%- if t.author != blank -%}<figcaption class="knr-ba__quote-author">{{ t.author }}</figcaption>{%- endif -%}
              </figure>
            {%- endfor -%}
          {%- else -%}
            {%- for block in section.blocks -%}
              <figure class="knr-ba__quote{% if forloop.first %} is-active{% endif %}" data-ba-slide {{ block.shopify_attributes }}>
                <blockquote class="knr-ba__quote-text">{{ block.settings.quote }}</blockquote>
                {%- if block.settings.author != blank -%}<figcaption class="knr-ba__quote-author">{{ block.settings.author | escape }}</figcaption>{%- endif -%}
              </figure>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{{ 'knr-before-after.css' | asset_url | stylesheet_tag }}
<script src="{{ 'knr-before-after.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "KNR Before/After",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Ce que disent nos clientes" },
    { "type": "richtext", "id": "description", "label": "Sous-titre", "default": "<p>Des transformations réelles, glissez pour comparer la peau avant et après une cure de 28 jours.</p>" },
    { "type": "header", "content": "Comparatif avant / après" },
    { "type": "image_picker", "id": "before_image", "label": "Image avant" },
    { "type": "image_picker", "id": "after_image", "label": "Image après" },
    { "type": "text", "id": "before_label", "label": "Libellé avant", "default": "Avant" },
    { "type": "text", "id": "after_label", "label": "Libellé après", "default": "Après" },
    { "type": "text", "id": "caption", "label": "Légende sous l'image" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Témoignage",
      "settings": [
        { "type": "richtext", "id": "quote", "label": "Citation" },
        { "type": "text", "id": "author", "label": "Auteur" }
      ]
    }
  ],
  "presets": [
    {
      "name": "KNR Before/After",
      "blocks": [
        { "type": "testimonial", "settings": { "quote": "<p>« J'utilise ce sérum depuis trois mois et la différence est saisissante. Mes rides d'expression sont visiblement atténuées et mon teint a retrouvé une luminosité que je n'avais plus depuis des années. »</p>", "author": "Claire, 52 ans" } },
        { "type": "testimonial", "settings": { "quote": "<p>« Les taches se sont estompées dès la troisième semaine. Une texture sensorielle qui pénètre instantanément. Je recommande les yeux fermés. »</p>", "author": "Nadia, 39 ans" } },
        { "type": "testimonial", "settings": { "quote": "<p>« Mon teint n'a jamais été aussi lumineux. Des résultats au rendez-vous, sans compromis sur le plaisir d'application. »</p>", "author": "Hélène, 45 ans" } }
      ]
    }
  ]
}
{% endschema %}
