{%- liquid
  assign before_img = product.metafields.custom.before_image.value | default: section.settings.before_image
  assign after_img = product.metafields.custom.after_image.value | default: section.settings.after_image

  assign t_items = product.metafields.custom.testimonials.value
  assign has_meta_t = false
  if t_items != blank
    assign has_meta_t = true
  endif
  if has_meta_t
    assign t_count = t_items | size
  else
    assign t_count = section.blocks.size
  endif
-%}

<section class="knr-ba" data-ba>
  <div class="knr-ba__head">
    {%- if section.settings.heading != blank -%}
      <h2 class="knr-ba__title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.description != blank -%}
      <div class="knr-ba__desc">{{ section.settings.description }}</div>
    {%- endif -%}
  </div>

  <div class="knr-ba__compare" data-ba-compare>
    <div class="knr-ba__layer knr-ba__before">
      {%- if before_img != blank -%}
        {{ before_img | image_url: width: 1280 | image_tag: class: 'knr-ba__img', loading: 'lazy', widths: '640, 1280', sizes: '(max-width: 749px) 100vw, 1280px', alt: '' }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'knr-ba__img knr-ba__img--ph' }}
      {%- endif -%}
    </div>
    <div class="knr-ba__layer knr-ba__after">
      {%- if after_img != blank -%}
        {{ after_img | image_url: width: 1280 | image_tag: class: 'knr-ba__img', loading: 'lazy', widths: '640, 1280', sizes: '(max-width: 749px) 100vw, 1280px', alt: '' }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'knr-ba__img knr-ba__img--ph' }}
      {%- endif -%}
    </div>

    <span class="knr-ba__tag knr-ba__tag--before">{{ section.settings.before_label | default: 'Avant' }}</span>
    <span class="knr-ba__tag knr-ba__tag--after">{{ section.settings.after_label | default: 'Après' }}</span>

    <div class="knr-ba__divider"></div>
    <div class="knr-ba__handle" aria-hidden="true">
      <svg class="knr-ba__grip" viewBox="0 0 12 12" fill="none" focusable="false"><path d="M3.5 2.5v7M6 2.5v7M8.5 2.5v7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
    </div>
    <input type="range" class="knr-ba__range" min="0" max="100" value="50" step="0.1" data-ba-range aria-label="Comparer l'avant et l'après">
  </div>

  {%- if t_count > 0 -%}
    <div class="knr-ba__reviews" data-ba-carousel>
      <div class="knr-ba__slides">
        {%- if has_meta_t -%}
          {%- for t in t_items -%}
            <figure class="knr-ba__slide{% if forloop.first %} is-active{% endif %}" data-ba-slide>
              <div class="knr-ba__rating">
                {% render 'knr-rating', rating: t.rating, label: t.rating %}
                <span class="knr-ba__name">{{ t.name }}</span>
              </div>
              <p class="knr-ba__text">{{ t.text }}</p>
            </figure>
          {%- endfor -%}
        {%- else -%}
          {%- for block in section.blocks -%}
            <figure class="knr-ba__slide{% if forloop.first %} is-active{% endif %}" data-ba-slide {{ block.shopify_attributes }}>
              <div class="knr-ba__rating">
                {% render 'knr-rating', rating: block.settings.rating, label: block.settings.rating %}
                <span class="knr-ba__name">{{ block.settings.name | escape }}</span>
              </div>
              <p class="knr-ba__text">{{ block.settings.text }}</p>
            </figure>
          {%- endfor -%}
        {%- endif -%}
      </div>

      {%- if t_count > 1 -%}
        <div class="knr-ba__nav">
          <button type="button" class="knr-ba__arrow" data-ba-prev aria-label="Témoignage précédent">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button type="button" class="knr-ba__arrow" data-ba-next aria-label="Témoignage suivant">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}
</section>

{{ 'knr-before-after.css' | asset_url | stylesheet_tag }}
<script src="{{ 'knr-before-after.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "KNR Before/After",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Ce que disent nos clientes" },
    { "type": "richtext", "id": "description", "label": "Sous-titre", "default": "<p>Des transformations visibles dès 4 semaines. Nos clientes témoignent d'une peau visiblement régénérée, plus ferme et lumineuse.</p>" },
    { "type": "header", "content": "Comparatif avant / après" },
    { "type": "image_picker", "id": "before_image", "label": "Image avant" },
    { "type": "image_picker", "id": "after_image", "label": "Image après" },
    { "type": "text", "id": "before_label", "label": "Libellé avant", "default": "Avant" },
    { "type": "text", "id": "after_label", "label": "Libellé après", "default": "Après" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Témoignage",
      "settings": [
        { "type": "text", "id": "name", "label": "Nom" },
        { "type": "range", "id": "rating", "label": "Note", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "text", "label": "Témoignage" }
      ]
    }
  ],
  "presets": [
    {
      "name": "KNR Before/After",
      "blocks": [
        { "type": "testimonial", "settings": { "name": "Clara T.", "rating": 5, "text": "J'utilise ce sérum depuis trois mois et la différence est saisissante. Mes rides d'expression se sont considérablement atténuées et mon teint a retrouvé une luminosité que je n'avais plus depuis des années." } },
        { "type": "testimonial", "settings": { "name": "Sophie M.", "rating": 5, "text": "Les taches pigmentaires se sont estompées dès la troisième semaine. Une texture sensorielle qui pénètre instantanément, sans effet collant. Je recommande les yeux fermés." } },
        { "type": "testimonial", "settings": { "name": "Inès D.", "rating": 4, "text": "Ma peau est visiblement plus ferme et lumineuse après un mois. Un rituel du soir devenu indispensable, avec des résultats au rendez-vous." } }
      ]
    }
  ]
}
{% endschema %}
