{%- liquid
  assign steps = product.metafields.custom.steps.value
  assign use_meta = false
  if steps != blank
    assign use_meta = true
  endif
-%}

<section class="knr-htu" data-htu>
  <div class="knr-htu__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="knr-htu__title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <div class="knr-htu__intro">{{ section.settings.subheading }}</div>
    {%- endif -%}

    <ol class="knr-htu__steps" data-htu-track>
      {%- if use_meta -%}
        {%- for step in steps -%}
          <li class="knr-htu__step">
            <div class="knr-htu__media">
              {%- if step.image != blank -%}
                {{ step.image | image_url: width: 896 | image_tag: class: 'knr-htu__img', loading: 'lazy', widths: '448, 896', sizes: '(max-width: 749px) 100vw, 33vw', alt: step.title }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'knr-htu__img knr-htu__img--ph' }}
              {%- endif -%}
            </div>
            <div class="knr-htu__details">
              <span class="knr-htu__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <h3 class="knr-htu__step-title">{{ step.title }}</h3>
              <div class="knr-htu__step-body">{{ step.body }}</div>
              {%- if section.settings.more_label != blank -%}
                <a class="knr-htu__more" href="{{ step.link | default: product.url }}">{{ section.settings.more_label }}</a>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          <li class="knr-htu__step" {{ block.shopify_attributes }}>
            <div class="knr-htu__media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 896 | image_tag: class: 'knr-htu__img', loading: 'lazy', widths: '448, 896', sizes: '(max-width: 749px) 100vw, 33vw', alt: block.settings.title | escape }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'knr-htu__img knr-htu__img--ph' }}
              {%- endif -%}
            </div>
            <div class="knr-htu__details">
              <span class="knr-htu__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <h3 class="knr-htu__step-title">{{ block.settings.title | escape }}</h3>
              <div class="knr-htu__step-body">{{ block.settings.body }}</div>
              {%- if section.settings.more_label != blank -%}
                <a class="knr-htu__more" href="{{ block.settings.link | default: product.url }}">{{ section.settings.more_label }}</a>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ol>

    <div class="knr-htu__progress" data-htu-progress aria-hidden="true">
      <span class="knr-htu__progress-thumb" data-htu-thumb></span>
    </div>
  </div>
</section>

{{ 'knr-how-to-use.css' | asset_url | stylesheet_tag }}
<script src="{{ 'knr-how-to-use.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "KNR How-to-use",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Comment l'utiliser" },
    { "type": "richtext", "id": "subheading", "label": "Sous-titre (optionnel)" },
    { "type": "text", "id": "more_label", "label": "Libellé du lien (mobile)", "default": "Lire plus" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Étape",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Titre" },
        { "type": "richtext", "id": "body", "label": "Texte" },
        { "type": "url", "id": "link", "label": "Lien « Lire plus » (optionnel)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "KNR How-to-use",
      "blocks": [
        { "type": "step", "settings": { "title": "Nettoyez", "body": "<p>Sur une peau propre et sèche, tamponnez délicatement pour retirer l'excédent d'eau.</p>" } },
        { "type": "step", "settings": { "title": "Appliquez", "body": "<p>Déposez 3 à 4 gouttes de sérum et massez du bout des doigts, du centre vers l'extérieur.</p>" } },
        { "type": "step", "settings": { "title": "Hydratez", "body": "<p>Scellez le soin avec votre crème hydratante habituelle, matin et soir.</p>" } }
      ]
    }
  ]
}
{% endschema %}
